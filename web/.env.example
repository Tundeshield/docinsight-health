# From Firebase console → Project settings → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_APP_ID=
VITE_FUNCTIONS_REGION=europe-west1
# The deployed "ask" function URL (shown after `firebase deploy --only functions`)
VITE_ASK_URL=https://europe-west1-your-project.cloudfunctions.net/ask
# Set to true to use the local Firebase emulators
VITE_USE_EMULATORS=false
# Where hospitals reach Avelon (Enterprise enquiries)
VITE_CONTACT_EMAIL=
